{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"babich-chat-ui": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/babich-chat-ui",
			"sourceRoot": "projects/babich-chat-ui/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"styles": [
							"node_modules/@angular/cdk/overlay-prepackaged.css",
							"projects/babich-chat-ui/src/styles.scss",
							"projects/babich-chat-ui/src/app/styles/overlays/_users-panel.scss"
						]
					},
					"configurations": {
						"production": {
							"target": "babich-chat-ui:esbuild:production"
						},
						"development": {
							"target": "babich-chat-ui:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-federation": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "babich-chat-ui:serve-original:development",
						"rebuildDelay": 500,
						"dev": true,
						"cacheExternalArtifacts": false,
						"port": 4201,
						"host": "0.0.0.0"
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/babich-chat-ui/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/babich-chat-ui/public"
							}
						],
						"styles": [
							"projects/babich-chat-ui/src/styles.scss"
						]
					}
				},
				"esbuild": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "projects/babich-chat-ui/src/main.ts",
						"tsConfig": "projects/babich-chat-ui/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/babich-chat-ui/public"
							}
						],
						"styles": [
							"projects/babich-chat-ui/src/styles.scss"
						],
						"polyfills": [
							"es-module-shims"
						]
					},
					"configurations": {
						"production": {
							"baseHref": "/chat/",
							"fileReplacements": [
								{
									"replace": "projects/babich-chat-ui/src/environments/environment.ts",
									"with": "projects/babich-chat-ui/src/environments/environment.prod.ts"
								}
							],
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "12kB",
									"maximumError": "16kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"esbuild-standalone": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "projects/babich-chat-ui/src/main.standalone.ts",
						"tsConfig": "projects/babich-chat-ui/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/babich-chat-ui/public"
							}
						],
						"styles": [
							"projects/babich-chat-ui/src/styles.scss",
							"node_modules/@angular/cdk/overlay-prebuilt.css",
							"projects/babich-chat-ui/src/app/styles/overlays/_users-panel.scss"
						]
					},
					"configurations": {
						"production": {
							"baseHref": "/babich-chat/",
							"outputPath": "dist/babich-chat-standalone",
							"fileReplacements": [
								{
									"replace": "projects/babich-chat-ui/src/environments/environment.ts",
									"with": "projects/babich-chat-ui/src/environments/environment.prod.ts"
								}
							],
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "12kB",
									"maximumError": "16kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-standalone": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "babich-chat-ui:esbuild-standalone:production"
						},
						"development": {
							"buildTarget": "babich-chat-ui:esbuild-standalone:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4201,
						"proxyConfig": "projects/babich-chat-ui/proxy.conf.json"
					}
				}
			}
		},
		"platform": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/platform",
			"sourceRoot": "projects/platform/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "platform:esbuild:production"
						},
						"development": {
							"target": "platform:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "platform:serve-original:development",
						"rebuildDelay": 500,
						"dev": true,
						"cacheExternalArtifacts": false,
						"port": 0
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/platform/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/platform/public"
							}
						],
						"styles": [
							"projects/platform/src/styles.scss"
						]
					}
				},
				"esbuild": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "projects/platform/src/main.ts",
						"tsConfig": "projects/platform/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/platform/public"
							}
						],
						"styles": [
							"projects/platform/src/styles.scss"
						],
						"polyfills": [
							"es-module-shims"
						]
					},
					"configurations": {
						"production": {
							"baseHref": "/platform/",
							"fileReplacements": [
								{
									"replace": "projects/platform/src/environments/environment.ts",
									"with": "projects/platform/src/environments/environment.prod.ts"
								}
							],
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "platform:esbuild:production"
						},
						"development": {
							"buildTarget": "platform:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200
					}
				}
			}
		}
	}
}